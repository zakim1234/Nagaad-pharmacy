PORT=5010
# Stock, purchase payments, and Close Day require a replica set (or MongoDB Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/pos_inventory?replicaSet=rs0
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call the API with credentials.
# Include your deployed frontend origin(s) and, for local development, the
# Vite dev server origin.
CLIENT_ORIGIN=https://inventory.elivateict.com,http://localhost:5173

# Used only by `npm run seed:admin` to create the initial admin account.
# SEED_ADMIN_PASSWORD is required and must be at least 12 characters -- the
# script refuses to run without it and refuses common weak passwords.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=use_a_strong_password_here
